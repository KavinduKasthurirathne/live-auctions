rules_version = '2';

// HCCL — Firestore Security Rules
// Deploy: Firebase console -> Firestore Database -> Rules -> paste -> Publish.
// Roles: admin (all), moderator (edit/delete app data), captain (read + raise bids
// on the live auction doc ONLY), viewer (read-only).
// The owner email is the bootstrap admin (works even before its user doc exists).

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function isOwner() {
      return signedIn() && request.auth.token.email == 'kavindu.kasthu@gmail.com';
    }
    function hasUserDoc() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function myRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function isAdmin() {
      return isOwner() || (signedIn() && hasUserDoc() && myRole() == 'admin');
    }
    function canEdit() {
      return isAdmin() || (signedIn() && hasUserDoc() && myRole() == 'moderator');
    }
    // Captains (Phase E) are read-only EXCEPT they may raise auction bids — see the
    // dedicated /auction/league/state/live rule below. They are NOT editors.
    function isCaptain() {
      return signedIn() && hasUserDoc() && myRole() == 'captain';
    }

    // User profiles + roles
    match /users/{uid} {
      // You can read your own profile; admins can read anyone's.
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      // Only admins can enumerate the whole member list (Members screen).
      allow list: if isAdmin();
      // A user may create only their OWN profile, and only as 'viewer'
      // (the owner email may bootstrap itself as 'admin').
      allow create: if signedIn() && request.auth.uid == uid
                    && (isOwner() || request.resource.data.role == 'viewer');
      // Only admins can change/remove roles.
      allow update, delete: if isAdmin();
    }

    // Shared fantasy data (Phase C): fantasy/league/{teams|players|contestants|days}/{id}.
    // Must be signed in to read (no anonymous viewing); only editors write.
    match /fantasy/{document=**} {
      allow read: if signedIn();
      allow write: if canEdit();
    }

    // Shared auction data (Phase D): auction/league/{teams|players}/{id} + state docs.
    match /auction/{document=**} {
      allow read: if signedIn();
      allow write: if canEdit();
    }

    // Captain bidding (Phase E): the live auction state is the ONLY thing captains may
    // write — this is how "raise paddle" works. Firestore grants access if ANY matching
    // rule allows, so this only widens write access for this single doc; teams, players,
    // settings, photos, fantasy and user roles all stay editor/admin-only above.
    match /auction/league/state/live {
      allow read: if signedIn();
      allow write: if canEdit() || isCaptain();
    }
  }
}
