rules_version = '2';

// HCCL - Firestore Security Rules
// Deploy: Firebase console -> Firestore Database -> Rules -> paste -> Publish.
// Roles: admin (all), moderator (edit/delete app data), viewer (read-only).
// The owner email is the bootstrap admin (works even before its user doc exists).

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function isOwner() {
      return signedIn() && request.auth.token.email == 'kavindu.kasthu@gmail.com';
    }
    function hasUserDoc() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function myRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function isAdmin() {
      return isOwner() || (signedIn() && hasUserDoc() && myRole() == 'admin');
    }
    function canEdit() {
      return isAdmin() || (signedIn() && hasUserDoc() && myRole() == 'moderator');
    }

    // User profiles + roles
    match /users/{uid} {
      // You can read your own profile; editors (admin + moderator) can read
      // anyone's - they share the Members / engagement dashboard.
      allow get: if signedIn() && (request.auth.uid == uid || canEdit());
      // Editors enumerate the member list (Members screen + engagement board).
      allow list: if canEdit();
      // A user may create only their OWN profile, and only as 'viewer'
      // (the owner email may bootstrap itself as 'admin').
      allow create: if signedIn() && request.auth.uid == uid
                    && (isOwner() || request.resource.data.role == 'viewer');
      // Admins can change/remove roles. A user may ALSO update their OWN doc,
      // but ONLY the visit/engagement fields - affectedKeys hasOnly() blocks
      // self-promotion or any other field edit. (These counters are written by
      // the client, so treat them as indicative, not audited.) Deletes stay
      // admin-only.
      allow update: if isAdmin()
                    || (signedIn() && request.auth.uid == uid
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['lastAccessedAt', 'timeMs', 'visits', 'pages']));
      allow delete: if isAdmin();
    }

    // Shared fantasy data (Phase C): fantasy/league/{teams|players|contestants|days}/{id}.
    // Must be signed in to read (no anonymous viewing); only editors write.
    // NOTE: the contestants' own fantasy teams are NOT under here - they live at
    // fantasyEntries/** below, precisely because this recursive rule cannot be
    // tightened. Do not add a get()-based rule to days/{id}: a batched editor
    // save runs to 450 documents and would blow the 20-access-call cap.
    match /fantasy/{document=**} {
      allow read: if signedIn();
      allow write: if canEdit();
    }

    // Fantasy contestant entries: fantasyEntries/{tid}/days/{dayId}/entries/{entryId}.
    // One document per contestant per match. entryId == the submitter's uid for a
    // self-submitted team, or "g_…" for a guest entry a moderator adds on behalf
    // of someone with no account. `tid` is the tournament id - "hccl-s6" is the
    // legacy tournament, whose match days live at the top-level fantasy/ root.
    //
    // These sit OUTSIDE fantasy/ and tournaments/ on purpose. Both of those roots
    // are guarded by recursive {document=**} rules granting read to any signed-in
    // user and write to any editor, and because rules are OR-ed, nothing nested
    // under them can ever be made STRICTER. This feature needs two things those
    // rules would silently defeat: rivals' picks stay hidden until the deadline,
    // and the deadline binds moderators too.
    //
    // The lock is the whole point. Once lockAt has passed - or once the points are
    // published - NOBODY may create, edit or delete an entry, admins included. To
    // reopen, an editor pushes lockAt forward, which is visible to every
    // contestant because their countdown changes, and unpublishes the points
    // first if they were already out.
    //
    // NOT enforced here: the match's optional "max players from one team" cap.
    // Checking it would mean reading every picked player's document to learn its
    // team, far past the access-call budget. Squad size, distinctness, C/VC
    // validity and the deadline ARE enforced; the per-team cap is UI-only.
    match /fantasyEntries/{tid}/days/{dayId}/entries/{entryId} {
      // && and || short-circuit, so only the branch whose root actually exists is
      // ever fetched - a get() on a missing document would fail the whole rule.
      // Repeated get()s of one path are cached, so this is a single access call.
      function legacyDay()  { return get(/databases/$(database)/documents/fantasy/league/days/$(dayId)).data; }
      function tourneyDay() { return get(/databases/$(database)/documents/tournaments/$(tid)/fantasy/league/days/$(dayId)).data; }
      function isLegacy()   { return tid == 'hccl-s6'; }

      function openFor(day) {
        return day.lockAt is number
            && request.time.toMillis() < day.lockAt
            && day.hasResults != true;
      }
      function matchOpen() {
        return (isLegacy() && openFor(legacyDay())) || (!isLegacy() && openFor(tourneyDay()));
      }

      // Exactly teamSize DISTINCT players. toSet() is what stops someone listing
      // the same player six times to multiply the captain bonus.
      function squadOk(d, day) {
        return day.teamSize is int && day.teamSize > 0 && day.teamSize <= 15
            && d.playerIds is list
            && d.playerIds.size() == day.teamSize
            && d.playerIds.toSet().size() == day.teamSize
            && (d.captainId in d.playerIds)
            && (d.viceCaptainId in d.playerIds)
            && d.captainId != d.viceCaptainId;
      }
      function squadMatches() {
        return (isLegacy() && squadOk(request.resource.data, legacyDay()))
            || (!isLegacy() && squadOk(request.resource.data, tourneyDay()));
      }
      // A closed allowlist. Points are always DERIVED from the match's own
      // performance map, never stored on the entry, so an injected score field
      // can't forge a result.
      function shapeOk() {
        return request.resource.data.keys().hasOnly(
                 ['uid','name','photo','teamName','playerIds','captainId','viceCaptainId','createdAt','updatedAt'])
            && request.resource.data.keys().hasAll(
                 ['uid','name','playerIds','captainId','viceCaptainId'])
            && request.resource.data.uid is string
            && request.resource.data.name is string
            && request.resource.data.name.size() > 0
            && request.resource.data.name.size() <= 120;
      }

      // Your own team is always visible to you; everyone else's opens at lock
      // time. get and list are split deliberately - a list rule must never touch
      // resource.data or the whole collection query fails, not just one document.
      allow get:  if signedIn() && (entryId == request.auth.uid || canEdit() || !matchOpen());
      allow list: if signedIn() && (canEdit() || !matchOpen());

      // A moderator's guest entry must use a "g_" id: without that, they could
      // key an entry to a real member's uid and squat their slot.
      allow create, update: if signedIn() && matchOpen() && shapeOk() && squadMatches()
                            && (
                                 (entryId == request.auth.uid
                                  && request.resource.data.uid == request.auth.uid)
                                 || (canEdit()
                                     && entryId.matches('^g_[a-z0-9]+$')
                                     && request.resource.data.uid == '')
                               );
      allow delete: if signedIn() && matchOpen() && (entryId == request.auth.uid || canEdit());
    }

    // Shared auction data (Phase D): auction/league/{teams|players}/{id} + state docs.
    match /auction/{document=**} {
      allow read: if signedIn();
      allow write: if canEdit();
    }

    // Player ranking boards: ranking/league = { version, batting, bowling,
    // allrounder }. Seeded/updated by editors; everyone signed in reads.
    match /ranking/{document=**} {
      allow read: if signedIn();
      allow write: if canEdit();
    }

    // Home page seasons: home/seasons = { version, seasons:[...] }.
    // Seeded/updated by editors; everyone signed in reads.
    match /home/{document=**} {
      allow read: if signedIn();
      allow write: if canEdit();
    }

    // Per-season player stats: seasonStats/S1 … seasonStats/S6 (each { season,
    // players:[…] }) + seasonStats/index. Uploaded by editors from the bundled
    // season CSVs; everyone signed in reads.
    match /seasonStats/{document=**} {
      allow read: if signedIn();
      allow write: if canEdit();
    }

    // Live season stats override: seasonStatsLive/S{no} = { season, csv,
    // playerCount, updatedAt, updatedBy }. Editors import a fresh CSV while a
    // season is ongoing to update that season's leaderboard for everyone in
    // real time, without a redeploy. Separate from the write-only seasonStats/*
    // archival mirror above.
    match /seasonStatsLive/{document=**} {
      allow read: if signedIn();
      allow write: if canEdit();
    }

    // Season MVP: mvp/{matchId} = one parsed STUMPS match report.
    // Editors upload/delete matches; everyone signed in reads (scores are
    // computed client-side from these docs).
    match /mvp/{document=**} {
      allow read: if signedIn();
      allow write: if canEdit();
    }

    // Fixtures & Results: matches/{id} = one scheduled/played match (teams,
    // date, venue, status, result + imported STUMPS scorecard).
    // Editors create/edit/publish/delete; everyone signed in reads (the
    // standings are computed client-side from these docs).
    match /matches/{document=**} {
      allow read: if signedIn();
      allow write: if canEdit();
    }

    // Series & tournaments: tournaments/{tid} = meta (name, logo, duration,
    // status) + tournaments/_config = { activeId }. Each NON-legacy
    // tournament's data lives under tournaments/{tid}/{auction|fantasy|
    // matches|mvp}/... - the legacy tournament (HCCL S6) keeps using the
    // original top-level roots above. Editors manage; signed-in users read.
    match /tournaments/{document=**} {
      allow read: if signedIn();
      allow write: if canEdit();
    }

    // HC News (Home page feed): news/{postId} = { title, text, images: [dataURL],
    // authorUid, authorName, authorPhoto, createdAt }. Moderators/admins post
    // (only as themselves); everyone signed in reads; the author or an admin
    // deletes. Posts are never edited - delete and repost instead. Likes and
    // comments live OUTSIDE the post doc (see below) so a story's inlined images
    // are never rewritten or re-pushed to every reader just because someone
    // tapped the heart.
    match /news/{postId} {
      allow read: if signedIn();
      allow create: if canEdit()
                    && request.resource.data.authorUid == request.auth.uid
                    && request.resource.data.text is string
                    && request.resource.data.text.size() > 0
                    && request.resource.data.text.size() <= 2000;
      allow delete: if isAdmin() || (canEdit() && resource.data.authorUid == request.auth.uid);
      allow update: if false;

      // Comments: news/{postId}/comments/{cid} = { uid, name, photo, text,
      // createdAt }. ANY signed-in user (viewers included) may comment, but
      // only as themselves. Never edited. Deleted by the comment's author, an
      // admin, or the story's own author.
      match /comments/{cid} {
        allow read: if signedIn();
        allow create: if signedIn()
                      && request.resource.data.uid == request.auth.uid
                      && request.resource.data.text is string
                      && request.resource.data.text.size() > 0
                      && request.resource.data.text.size() <= 500;
        allow update: if false;
        allow delete: if signedIn() && (
                        resource.data.uid == request.auth.uid
                        || isAdmin()
                        || (canEdit()
                            && exists(/databases/$(database)/documents/news/$(postId))
                            && get(/databases/$(database)/documents/news/$(postId)).data.authorUid == request.auth.uid));
      }
    }

    // Story likes: newsLikes/{postId} = { u: { <uid>: { n, p, t } } } - ONE small
    // doc per story holding every liker, so the whole feed's like state is a
    // single collection listener. The display name/photo are denormalized
    // because a viewer cannot read anyone else's users/{uid} doc.
    //
    // The diff()/affectedKeys()/hasOnly() pairs are the whole security story: a
    // signed-in user may add or remove ONLY their own uid key inside `u`, and
    // may not introduce any other field. Counts therefore can't be forged.
    match /newsLikes/{postId} {
      allow read: if signedIn();
      // First like on a story creates the doc. exists() keeps likes for
      // nonexistent stories out of a collection every reader downloads.
      allow create: if signedIn()
                    && exists(/databases/$(database)/documents/news/$(postId))
                    && request.resource.data.keys().hasOnly(['u'])
                    && request.resource.data.u.keys().hasOnly([request.auth.uid]);
      allow update: if signedIn()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['u'])
                    && request.resource.data.u.diff(resource.data.u).affectedKeys().hasOnly([request.auth.uid]);
      // Editors clear the doc when they delete the story it belongs to.
      allow delete: if canEdit();
    }
  }
}
